# Requestify deployment config, read by docker-compose.yml.
# Copy to .env (never commit it) and fill in every value.

# --- Public address -------------------------------------------------------
# Domain whose DNS A record points at the server -> automatic HTTPS.
# Use :80 to test over plain HTTP by IP before you have a domain.
SITE_ADDRESS=requestify.example.com
# Full public URL; encoded into each DJ's QR code at sign-up
PUBLIC_APP_URL=https://requestify.example.com

# --- Database -------------------------------------------------------------
# "db" runs MySQL in a container on the same server (data kept in a Docker volume).
# For Cloud SQL / RDS: set COMPOSE_PROFILES= (empty), and point DB_HOST/DB_PORT at it.
COMPOSE_PROFILES=db
DB_HOST=db
DB_PORT=3306
DB_NAME=Requestify
DB_USER=requestify
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Firebase -------------------------------------------------------------
# Service account key (Firebase console > Project settings > Service accounts)
FIREBASE_KEY_FILE=./requestify/Firebase-Service-Key.json
# Web app config (Firebase console > Project settings > General); public, baked into the frontend
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# --- Spotify (server-side only) -------------------------------------------
REACT_APP_SPOTIFY_CLIENT_ID=
REACT_APP_SPOTIFY_SECRET_CLIENT_ID=

# --- Stripe (server-side only) --------------------------------------------
REACT_APP_STRIPE_SECRET_KEY=
# Webhook signing secret; the webhook URL is <PUBLIC_APP_URL>/api/webhooks/stripe
REACT_APP_STRIPE_SIGNING_KEY=
